# Copy to .env and fill in. .env is gitignored.

# PostgreSQL + pgvector (docker-compose.yml)
POSTGRES_USER=datasheet_rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=datasheet_rag
POSTGRES_HOST=localhost
# Host port of the container; use another one (e.g. 5433) if a local PostgreSQL already uses 5432.
POSTGRES_PORT=5432
